{
  "name": "@omnifield/probe-web-skin-reference",
  "version": "0.0.0",
  "description": "Эталонный скин probe-web: одна настоящая запись переменных и рецептов, проходящая механику целиком (PWEB-75). Отдельная поставка — механика не знает ни одного скина.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && pnpm run typecheck",
    "test": "pnpm run build && vitest run"
  },
  "peerDependencies": {
    "@omnifield/probe-web-skin": "^0.1.0",
    "@omnifield/probe-web-ui": "^0.1.0"
  },
  "devDependencies": {
    "@omnifield/live-check": "workspace:*",
    "@omnifield/probe-web-lint": "workspace:*",
    "@omnifield/probe-web-skin": "workspace:*",
    "@omnifield/probe-web-style": "workspace:*",
    "@omnifield/probe-web-ui": "workspace:*",
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.7",
    "eslint": "^10.8.1",
    "postcss": "^8.5.14",
    "postcss-nested": "^7.0.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
