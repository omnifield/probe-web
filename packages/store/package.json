{
  "name": "@web-core/store",
  "version": "0.1.0",
  "description": "Стейт web-core поверх семьи XState: @xstate/store как zustand-подобное глобальное хранилище, xstate как опциональный слой полноценных стейт-машин (PROBEWEB-4).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/flat/index.d.ts",
      "default": "./dist/flat/index.js"
    },
    "./machine": {
      "types": "./dist/machine/index.d.ts",
      "default": "./dist/machine/index.js"
    },
    "./persist": {
      "types": "./dist/persist/index.d.ts",
      "default": "./dist/persist/index.js"
    },
    "./undo": {
      "types": "./dist/undo/index.d.ts",
      "default": "./dist/undo/index.js"
    },
    "./reset": {
      "types": "./dist/reset/index.d.ts",
      "default": "./dist/reset/index.js"
    },
    "./validate": {
      "types": "./dist/validate/index.d.ts",
      "default": "./dist/validate/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && pnpm run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@xstate/store": "^4.2.3",
    "@xstate/store-solid": "^2.0.0"
  },
  "peerDependencies": {
    "@xstate/solid": "^2.0.0",
    "solid-js": "^1.9.14",
    "xstate": "^5.32.6"
  },
  "peerDependenciesMeta": {
    "@xstate/solid": {
      "optional": true
    },
    "xstate": {
      "optional": true
    }
  },
  "devDependencies": {
    "@web-core/build": "workspace:*",
    "@web-core/lint": "workspace:*",
    "@types/node": "^24.10.1",
    "@xstate/solid": "^2.0.0",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "solid-js": "^1.9.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10",
    "xstate": "^5.32.6"
  }
}
