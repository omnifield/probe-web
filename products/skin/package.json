    "@omnifield/probe-web-lint": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
