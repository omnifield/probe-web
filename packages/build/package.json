{
  "name": "@web-core/build",
  "version": "0.1.0",
  "description": "Оснастка сборки web-core: фабрика конфига Vite, базовый tsconfig, пресет vitest и TS-раннер для серверов.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "web-core-node": "./dist/bin.mjs"
  },
  "exports": {
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest/index.d.ts",
      "default": "./dist/vitest/index.js"
    },
    "./tsconfig": "./dist/tsconfig/frontend.json",
    "./tsconfig-node": "./dist/tsconfig/node.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/tsconfig && cp src/tsconfig/frontend.json dist/tsconfig/frontend.json && cp src/tsconfig/node.json dist/tsconfig/node.json && cp src/tsconfig/shared.json dist/tsconfig/shared.json && cp src/bin.mjs dist/bin.mjs && chmod +x dist/bin.mjs",
    "prepare": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@web-core/trace": "workspace:*",
    "esbuild": "^0.27.7",
    "tsx": "^4.23.13",
    "vite-plugin-solid": "^2.11.14"
  },
  "peerDependencies": {
    "jsdom": "^30.0.1",
    "solid-js": "^1.9.14",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.10.1",
    "jsdom": "^30.0.1",
    "solid-js": "^1.9.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
