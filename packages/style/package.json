{
  "name": "@web-core/style",
  "version": "0.1.0",
  "description": "Набор значений web-core: токен-контракт, шкалы, роли, дефолтная пара тем. Один из поставщиков значений, а не фундамент; инструменты стилизации — отдельная поставка (PWEB-3).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generate": {
      "types": "./dist/css/generate.d.ts",
      "default": "./dist/css/generate.js"
    },
    "./base.css": "./dist/css/base.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
