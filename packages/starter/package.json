{
  "name": "@omnifield/probe-web",
  "version": "0.1.0",
  "description": "Обвес baser: скелет фронта probe-web в web/ — пять файлов placed-once поверх @omnifield/probe-web-kit.",
  "license": "UNLICENSED",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "template"
  ],
  "baser": {
    "formVersion": 3,
    "source": {
      "id": "omnifield/probe-web",
      "title": "Заготовка фронта probe-web",
      "contentRoot": "template"
    },
    "settings": {
      "kitVersion": {
        "title": "Версия @omnifield/probe-web-kit",
        "description": "Диапазон npm, который скелет пропишет зависимостью в web/package.json. Не заполнил у себя — версия едет за нашими выпусками; заполнил — замерла на твоём значении.",
        "type": "string",
        "default": "^0.1.0"
      },
      "productName": {
        "title": "Имя продукта",
        "description": "Идёт в поле name манифеста web/package.json. Дефолт совпадает с именем каталога, куда ложится скелет.",
        "type": "string",
        "default": "web"
      }
    },
    "layout": [
      {
        "src": "package.json.ejs",
        "dest": "web/package.json",
        "render": true,
        "class": "placed-once"
      },
      {
        "src": "index.html",
        "dest": "web/index.html",
        "render": false,
        "class": "placed-once"
      },
      {
        "src": "vite.config.ts",
        "dest": "web/vite.config.ts",
        "render": false,
        "class": "placed-once"
      },
      {
        "src": "tsconfig.json",
        "dest": "web/tsconfig.json",
        "render": false,
        "class": "placed-once"
      },
      {
        "src": "main.tsx",
        "dest": "web/src/main.tsx",
        "render": false,
        "class": "placed-once"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run typecheck",
    "test": "vitest run",
    "check": "baser check .",
    "payload": "D=\"${TMPDIR:-/tmp}/omnifield-probe-web-payload\"; rm -rf \"$D\" && baser pack . --into \"$D\""
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.10.1",
    "ejs": "^3.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
