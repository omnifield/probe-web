{
  "name": "@web-core/skin",
  "version": "0.0.0",
  "description": "web-core skin mechanic: model, part-by-part recipe assembly, anatomy-based addressing, CSS generation, and wearing it (switch/connection, PWEB-221) — a framework, not a product's own dressing.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    },
    "./flat": {
      "types": "./dist/flat.d.ts",
      "default": "./dist/flat.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./wear": {
      "types": "./dist/wear.d.ts",
      "default": "./dist/wear.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "default": "./dist/solid.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && pnpm run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@web-core/trace": "workspace:*",
    "@zag-js/anatomy": "^1.43.1"
  },
  "peerDependencies": {
    "@web-core/style": "^0.1.0",
    "postcss": "^8.5.14",
    "postcss-nested": "^7.0.2",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^5.0.2",
    "@kobalte/core": "^0.13.12",
    "@web-core/build": "workspace:*",
    "@web-core/lint": "workspace:*",
    "@web-core/style": "workspace:*",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.14",
    "postcss-nested": "^7.0.2",
    "solid-js": "^1.9.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    },
    "postcss-nested": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
