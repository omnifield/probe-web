{
  "name": "@omnifield/probe-web-ui",
  "version": "0.1.0",
  "description": "Примитивы probe-web поверх @kobalte/core: 1-to-1 DOM, ноль стилей по умолчанию, свои обработчики насквозь (kb:PROBEWEB-4).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "solid": "./dist/index.jsx",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./passport": {
      "types": "./dist/passport.d.ts",
      "default": "./dist/passport.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && pnpm run typecheck",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "@zag-js/accordion": "^1.43.1",
    "@zag-js/anatomy": "^1.43.1"
  },
  "peerDependencies": {
    "@ark-ui/solid": "^5.38.2",
    "@kobalte/core": "^0.13.12",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@ark-ui/solid": "^5.38.2",
    "@kobalte/core": "^0.13.12",
    "@omnifield/probe-web-lint": "workspace:*",
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.7",
    "esbuild-plugin-solid": "^0.6.0",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "solid-js": "^1.9.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  }
}
