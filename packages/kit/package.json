{
  "name": "@omnifield/probe-web-kit",
  "version": "0.1.0",
  "description": "Времянка-фреймворк probe-web: Solid + Vite за тремя замороженными точками (kb:PROBEWEB-2).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./tsconfig": "./tsconfig.base.json"
  },
  "files": [
    "dist",
    "tsconfig.base.json",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run typecheck",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "vite-plugin-solid": "^2.11.14"
  },
  "peerDependencies": {
    "solid-js": "^1.9.14",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.10.1",
    "jsdom": "^30.0.1",
    "solid-js": "^1.9.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
