{
  "name": "@web-core/shared",
  "version": "0.1.0",
  "description": "Общее для всех зон web-core: mount()/#root и perf-трейсер, чтобы не заводить по копии на зону.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./trace": {
      "types": "./dist/trace.d.ts",
      "default": "./dist/trace.js"
    },
    "./trace-life": {
      "types": "./dist/trace-life.d.ts",
      "default": "./dist/trace-life.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run typecheck",
    "test": "vitest run"
  },
  "peerDependencies": {
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@web-core/style": "workspace:*",
    "@types/node": "^24.10.1",
    "jsdom": "^30.0.1",
    "solid-js": "^1.9.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  }
}
