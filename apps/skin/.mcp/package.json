{
  "name": "@web-core/skin-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Зона skin-mcp: локальный MCP-сервер для создания скина — ручки на уже готовую механику packages/skin, а не новая. Обкатка v1 — только текст (CSS-текст, отчёты проверок); скриншот-превью — вторая волна.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "start": "web-core-node src/index.ts",
    "serve": "SKIN_MCP_TRANSPORT=http SKIN_MCP_HOST=0.0.0.0 web-core-node src/index.ts",
    "dev": "web-core-node watch src/index.ts",
    "push-to-prod": "node scripts/push-to-prod.mjs",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@web-core/io": "workspace:*",
    "@web-core/neurobox": "workspace:*",
    "@web-core/skin": "workspace:*",
    "@web-core/ui": "workspace:*",
    "zocker": "^3.0.0"
  },
  "devDependencies": {
    "@web-core/build": "workspace:*",
    "@types/node": "^24.10.1",
    "typescript": "^7.0.2"
  }
}
