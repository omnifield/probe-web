{
  "//": [
    "Конфиг САМОГО пакета. Своего `tsconfig` наружу зона не отдаёт — базу приложениям задаёт",
    "зона `build` подпутём `/tsconfig` (PROBEWEB-4).",
    "",
    "JSX здесь не настроен намеренно: эталон — ЗАПИСЬ, а не отрисовка. Ни одного компонента он",
    "не рисует и рисовать не может; живой вид проверяется настоящим браузером, а не Solid'ом в",
    "пробе."
  ],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "vitest.config.ts", "scripts"],
  "exclude": ["dist", "node_modules"]
}
