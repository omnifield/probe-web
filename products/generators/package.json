{
  "name": "@probe-web/generators",
  "version": "0.0.0",
  "private": true,
  "description": "Generation tooling: a vite/webpack-shaped runner (defineConfig + plugins) plus a CLI to run it. Component scaffolding, barrel sync in place of the ad-hoc packages/ui/scripts/generate.mjs, is only one consumer; test-data generation (faker) and other template-driven text generation are meant to land alongside it over time as their own plugins. Nothing in the repository is required to depend on this package — each zone opts in.",
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./extract": {
      "types": "./dist/extract/index.d.ts",
      "default": "./dist/extract/index.js"
    },
    "./preserve": {
      "types": "./dist/preserve/index.d.ts",
      "default": "./dist/preserve/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./plugins/kit": {
      "types": "./dist/plugins/kit/index.d.ts",
      "default": "./dist/plugins/kit/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "probe-generate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "handlebars": "^4.7.9",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@omnifield/probe-web-io": "workspace:*",
    "@omnifield/probe-web-skin": "workspace:*",
    "@types/node": "^24.10.1",
    "@zag-js/accordion": "^1.43.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
