{
  "name": "@omnifield/probe-web-skin",
  "version": "0.0.0",
  "description": "probe-web skin mechanic: model, part-by-part recipe assembly, anatomy-based addressing, and CSS generation (PWEB-4). The mechanic is a framework; the actual dressing lives in the product.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    },
    "./flat": {
      "types": "./dist/flat.d.ts",
      "default": "./dist/flat.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && pnpm run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@zag-js/anatomy": "^1.43.1"
  },
  "peerDependencies": {
    "@omnifield/probe-web-style": "^0.1.0",
    "postcss": "^8.5.14",
    "postcss-nested": "^7.0.2"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^5.0.2",
    "@kobalte/core": "^0.13.12",
    "@omnifield/probe-web-build": "workspace:*",
    "@omnifield/probe-web-lint": "workspace:*",
    "@omnifield/probe-web-runtime": "workspace:*",
    "@omnifield/probe-web-style": "workspace:*",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.14",
    "postcss-nested": "^7.0.2",
    "solid-js": "^1.9.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    },
    "postcss-nested": {
      "optional": true
    }
  }
}
