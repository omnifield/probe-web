{
  "name": "@web-core/mcp",
  "version": "0.0.0",
  "description": "Тулинг для MCP-серверов зон web-core: обязательные annotations и конверт ответа при регистрации тула (input/output — настоящие Zod-схемы), бутстрап транспорта (stdio/Streamable HTTP) с точкой расширения под auth, курсорная пагинация листингов.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "default": "./dist/transport/index.js"
    },
    "./pagination": {
      "types": "./dist/pagination/index.d.ts",
      "default": "./dist/pagination/index.js"
    },
    "./peer": {
      "types": "./dist/peer/index.d.ts",
      "default": "./dist/peer/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "default": "./dist/feedback/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && pnpm run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@web-core/io": "workspace:*",
    "@web-core/query": "workspace:*"
  },
  "devDependencies": {
    "@web-core/build": "workspace:*",
    "@web-core/lint": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "^10.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
